  {
   "start": 0.0,
   "end": 1.66,
   "text": "Hi, you're here!"
  },
  {
   "start": 1.76,
   "end": 3.14,
   "text": "Welcome to your neighborhood."
  },
  {
   "start": 3.3,
   "end": 4.98,
   "text": "There's lots to explore."
  },
  {
   "start": 5.58,
   "end": 6.78,
   "text": "See those shops?"
  },
  {
   "start": 6.88,
   "end": 8.72,
   "text": "As you earn coins, you'll be able to buy"
  },
  {
   "start": 8.72,
   "end": 11.72,
   "text": "cool clothes, hats, and other fun things!"
  },
  {
   "start": 11.76,
   "end": 14.08,
   "text": "But first, let's head inside your home."
  },
  {
   "start": 14.08,
   "end": 15.12,
   "text": "I'll show you around,"
  },
  {
   "start": 15.12,
   "end": 17.59,
   "text": "and you can make your avatar look the way you want."
  }
 ]
