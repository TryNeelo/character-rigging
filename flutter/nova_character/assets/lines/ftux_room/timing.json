  {
   "start": 0.0,
   "end": 1.46,
   "text": "This is your room!"
  },
  {
   "start": 1.74,
   "end": 3.62,
   "text": "Come on, I'll show you around."
  },
  {
   "start": 4.16,
   "end": 5.3,
   "text": "See that book?"
  },
  {
   "start": 5.36,
   "end": 6.9,
   "text": "That's your sticker book!"
  },
  {
   "start": 6.9,
   "end": 9.86,
   "text": "You earn stickers as you go on adventures in Neelo."
  },
  {
   "start": 9.9,
   "end": 11.26,
   "text": "When you get a new sticker,"
  },
  {
   "start": 11.26,
   "end": 12.94,
   "text": "you can come home to see it."
  },
  {
   "start": 13.5,
   "end": 15.5,
   "text": "And this is your closet."
  },
  {
   "start": 15.56,
   "end": 17.48,
   "text": "Want to choose a new look for your avatar?"
  },
  {
   "start": 17.54,
   "end": 18.62,
   "text": "Let's open it up!"
  }
 ]
